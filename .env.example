# ── Take In 네이티브 SDK 키 ──────────────────────────────
# 이 파일을 복사해 .env 를 만들고 값을 채우세요.
#   cp .env.example .env
# 값 변경 후에는 반드시: npx expo prebuild --clean && npx expo run:ios (또는 run:android)

# 네이버 클라우드 플랫폼(NCP) > Maps > Mobile Dynamic Map 의 Client ID
NAVER_MAP_CLIENT_ID=

# Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
KAKAO_NATIVE_APP_KEY=

# ── Supabase ─────────────────────────────────────────────
# https://supabase.com 프로젝트 → Settings → API 에서 복사
# EXPO_PUBLIC_ 접두사가 붙은 값은 JS 번들에 들어가므로 재빌드 불필요 (dev 서버 재시작만)

# Project URL (예: https://abcdefghijk.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# anon public key (Settings → API → Project API keys → anon public)
# ⚠️ service_role 키는 절대 여기 넣지 마세요 (서버 전용 비밀키)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
